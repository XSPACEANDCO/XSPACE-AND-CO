# Where the data lives.
#
# Leave it unset (or use a file: URL) for local work: the server runs an
# embedded Postgres that keeps everything in server/.data on this machine, so
# there is nothing to install and the accounts you create survive a restart.
#   DATABASE_URL=file:./.data/xspace
#
# In production this must be a real Postgres connection string - Render injects
# one when you attach a database. A file store there is refused at startup,
# because Render replaces the instance disk on every deploy.
# DATABASE_URL=postgresql://user:password@host:5432/xspace

# Sign the JWTs. Generate one with: openssl rand -base64 48
# Render: set this in the dashboard, never commit a real value.
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=10000
NODE_ENV=development
# Comma-separated origins allowed to call the API. Leave unset when the API
# and the built frontend are served from the same Render service.
CORS_ORIGINS=http://localhost:5173
# Where the built frontend lives, relative to server/. Set to "" to serve
# API only (e.g. if you host the frontend as a separate static site).
STATIC_DIR=../xspace-portal-react/dist
# --- Demo data -------------------------------------------------------------
# Inserts the five demo accounts. Defaults to true locally and FALSE in
# production, so a real deployment never ships shared-password accounts.
SEED_DEMO=true
SEED_PASSWORD=xspace123

# --- Login throttling (per 15 minutes) -------------------------------------
# Per account (IP + email): the brute-force brake.
LOGIN_ATTEMPTS_PER_ACCOUNT=10
# Per IP: the sweep brake. Loose on purpose — partners share office and
# mobile-carrier NAT addresses, so a tight per-IP limit locks out colleagues.
LOGIN_ATTEMPTS_PER_IP=100

# --- Accounts --------------------------------------------------------------
# Founder + Core are a fixed set of about ten people. Guardrail, not a rule.
MAX_INTERNAL_ACCOUNTS=10
# There is no public sign-up. Every account is created by a Founder or Core
# member, who passes the email and password to the person directly.

# --- First Founder on a fresh database -------------------------------------
# Render's free tier has no shell, so this is how you get your first real
# account in. Created on the next boot; skipped if the address already exists.
# Sign in, change the password, then clear BOOTSTRAP_PASSWORD.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
