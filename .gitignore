# Dependencies — Render reinstalls these from package-lock.json on every build.
node_modules/

# Build output — Render rebuilds it.
dist/
.vite/

# Secrets. DATABASE_URL and JWT_SECRET live in the Render dashboard,
# never in the repo.
.env
.env.*
!.env.example

# The local file store (server/.data) - an embedded Postgres keeping its data
# on this machine for testing. Real accounts and passwords live in here, and
# Render uses a managed database instead, so it never belongs in the repo.
.data/

# Local database dumps, if you ever pull one down for a backup.
*.dump
*.sql.gz
*.sqlite
*.sqlite3
*.db

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
logs/
